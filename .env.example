# 数据库
DATABASE_URL=sqlite+aiosqlite:///./scriptlens.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scriptlens

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# DeepSeek (用户自行填写)
DEEPSEEK_API_KEY=

# 文件存储
UPLOAD_DIR=./uploads

# 环境
ENV=development
